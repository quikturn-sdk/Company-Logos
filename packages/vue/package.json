{
  "name": "@quikturn/logos-vue",
  "version": "1.0.0",
  "description": "Vue 3 components for the Quikturn Logos API — QuikturnLogo, LogoCarousel, LogoGrid",
  "license": "MIT",
  "author": "Quikturn",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/quikturn-sdk/Logos.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/quikturn-sdk/Logos/issues"
  },
  "homepage": "https://github.com/quikturn-sdk/Logos/tree/main/packages/vue#readme",
  "keywords": [
    "quikturn",
    "logos",
    "vue",
    "company-logos",
    "brand-assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/ tests/"
  },
  "dependencies": {
    "@quikturn/logos": "workspace:^"
  },
  "peerDependencies": {
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@semantic-release/changelog": "catalog:",
    "@semantic-release/exec": "catalog:",
    "@semantic-release/git": "catalog:",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "jsdom": "catalog:",
    "semantic-release": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "catalog:",
    "vue": "catalog:vue3",
    "vue-tsc": "^3.3.8"
  }
}
