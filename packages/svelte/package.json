{
  "name": "@quikturn/logos-svelte",
  "version": "1.0.0",
  "description": "Svelte 5 components for the Quikturn Logos API — QuikturnLogo, LogoCarousel, LogoGrid",
  "license": "MIT",
  "author": "Quikturn",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/quikturn-sdk/Logos.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/quikturn-sdk/Logos/issues"
  },
  "homepage": "https://github.com/quikturn-sdk/Logos/tree/main/packages/svelte#readme",
  "keywords": [
    "quikturn",
    "logos",
    "svelte",
    "company-logos",
    "brand-assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "svelte-package -o dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src/ tests/"
  },
  "dependencies": {
    "@quikturn/logos": "workspace:^"
  },
  "peerDependencies": {
    "svelte": "^5.56.8"
  },
  "devDependencies": {
    "@semantic-release/changelog": "catalog:",
    "@semantic-release/exec": "catalog:",
    "@semantic-release/git": "catalog:",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "catalog:",
    "semantic-release": "catalog:",
    "svelte": "catalog:svelte5",
    "svelte-check": "^4.7.4",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
